{
  "author": "Speakeasy Support",
  "build": {
    "appId": "com.speakeasysupport.budgetplanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "oneClick": false
    },
    "productName": "Household Budget Planner",
    "win": {
      "icon": "app/icons/icon-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "description": "Household Budget & Car Payoff Planner \u2014 desktop app for Windows",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "household-budget-planner-desktop",
  "scripts": {
    "dist": "electron-builder --win nsis portable --publish never",
    "start": "electron ."
  },
  "version": "1.0.0"
}